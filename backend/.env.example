# ===================================================================
# CampusPulse Backend Environment Variables Template
# Copy this file to .env or configure in your deployment orchestrator
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR PASSWORDS TO SOURCE CONTROL
# ===================================================================

# -------------------------------------------------------------------
# Server Port (Binds dynamically to host $PORT, defaults to 8080)
# -------------------------------------------------------------------
PORT=8080

# -------------------------------------------------------------------
# Profile Selection
# Options:
#   default   - H2 file-based local development (./data/campuspulse_db)
#   postgres  - Local or staging PostgreSQL with auto-update DDL
#   prod      - Hardened PostgreSQL with schema validation
# -------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=postgres

# -------------------------------------------------------------------
# Option A: Full JDBC Connection URL (Recommended for Cloud / PaaS)
# e.g., Render, Railway, Neon, Supabase, AWS RDS
# -------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuspulse_db

# -------------------------------------------------------------------
# Option B: Individual PostgreSQL Connection Parameters
# -------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuspulse_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# -------------------------------------------------------------------
# HikariCP Connection Pool Tuning
# -------------------------------------------------------------------
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# -------------------------------------------------------------------
# Hibernate DDL Mode
# 'update'   - Development/Staging (creates/updates tables automatically)
# 'validate' - Production (verifies existing schema, zero mutations)
# -------------------------------------------------------------------
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# -------------------------------------------------------------------
# JWT Security Key (MUST be at least 256 bits / 32+ characters)
# Generate via: openssl rand -base64 32
# -------------------------------------------------------------------
JWT_SECRET=change_this_to_a_secure_random_base64_secret_key_minimum_32_characters_2026
JWT_EXPIRATION_MS=86400000

# -------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated)
# -------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------------
# Initial Administrator Bootstrap (Optional for initial account seeding)
# -------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@campuspulse.edu
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeToAStrongAdminPassword123!
