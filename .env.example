# ===================================================================
# CampusPulse Root Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration
# -------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL Connection (Use Option A or Option B)
# Option A: Full JDBC URL
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuspulse_db

# Option B: Component parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuspulse_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# JWT Security
JWT_SECRET=change_this_to_a_secure_random_base64_secret_key_minimum_32_characters_2026
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@campuspulse.edu
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeToAStrongAdminPassword123!

# -------------------------------------------------------------------
# Frontend Configuration (Vite)
# NOTE: Never store database passwords or JWT signing secrets here!
# -------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
