# ===================================================================
# CampusPulse Root Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT
# ===================================================================

# -------------------------------------------------------------------
# Backend Configuration
# -------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=postgres

# PostgreSQL Connection (Use Option A or Option B)
# Option A: Full JDBC URL
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/campuspulse_db

# Option B: Component parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=campuspulse_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# JWT Security
JWT_SECRET=change_this_to_a_secure_random_base64_secret_key_minimum_32_characters_2026
JWT_EXPIRATION_MS=86400000

# CORS — local development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# PRODUCTION (Render dashboard): CORS_ALLOWED_ORIGINS=https://campus-event-viewer.vercel.app,http://localhost:5173

# Main Admin Bootstrap (Single Main Admin policy; non-reentrant)
CAMPUSPULSE_ADMIN_EMAIL=admin@campuspulse.edu
CAMPUSPULSE_ADMIN_PASSWORD=ChangeMeToAStrongAdminPassword123!
# Legacy aliases supported:
# ADMIN_BOOTSTRAP_EMAIL=admin@campuspulse.edu
# ADMIN_BOOTSTRAP_PASSWORD=ChangeMeToAStrongAdminPassword123!
#
# PRODUCTION: Set CAMPUSPULSE_ADMIN_PASSWORD and ADMIN_BOOTSTRAP_PASSWORD as MANUAL SECRET
# environment variables in the Render dashboard (never use generateValue: true for passwords).

# -------------------------------------------------------------------
# Persistent Image Storage (Cloudinary - Backend only)
# Never expose these credentials to frontend/Vite bundles!
# -------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Optional single connection URL format:
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Upload file size limit in bytes (optional, default: 5242880 = 5MB):
# APP_UPLOAD_MAX_FILE_SIZE=5242880

# -------------------------------------------------------------------
# Frontend Configuration (Vite)
# NOTE: Never store database passwords or JWT signing secrets here!
# VITE_* variables are inlined at build time and visible in the compiled JS bundle.
# Only set non-secret configuration (API base URL, feature flags) here.
# -------------------------------------------------------------------
# Local development:
VITE_API_BASE_URL=http://localhost:8080/api
# PRODUCTION (Vercel dashboard > Settings > Environment Variables):
# VITE_API_BASE_URL=https://campuspulse-backend-vkgh.onrender.com/api
# This variable MUST be set in the Vercel project dashboard before building.
# Without it, the production frontend silently falls back to http://localhost:8080/api.
